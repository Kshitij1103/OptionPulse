{
  "name": "virtualtrading",
  "version": "1.0.0",
  "description": "Mobile Virtual Trading App for Indian Options (NSE/BSE)",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"yellow.bold,cyan.bold\" \"node server/index.js\" \"vite\"",
    "server": "node server/index.js",
    "client": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "keywords": [
    "options-trading",
    "nse",
    "nifty",
    "banknifty",
    "virtual-trading",
    "paper-trading"
  ],
